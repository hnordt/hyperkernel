{
  "name": "hyperkernel-workspace",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "A self-hostable platform for building connected, reliable, and auditable applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hnordt/hyperkernel.git"
  },
  "homepage": "https://github.com/hnordt/hyperkernel#readme",
  "bugs": {
    "url": "https://github.com/hnordt/hyperkernel/issues"
  },
  "keywords": [
    "application-platform",
    "modular-applications",
    "app-development",
    "self-hosting"
  ],
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "prepare": "npm run package --workspace @hyperkernel/ui && npm run prepare --workspace @hyperkernel/playground && husky",
    "dev": "npm run dev --workspace @hyperkernel/playground",
    "build": "npm run build --workspace @hyperkernel/ui && npm run build --workspace @hyperkernel/playground",
    "preview": "npm run preview --workspace @hyperkernel/playground",
    "start": "npm run start --workspace @hyperkernel/playground",
    "check": "npm run check --workspace @hyperkernel/ui && npm run package --workspace @hyperkernel/ui && npm run check --workspace @hyperkernel/playground",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:unit": "npm run test:unit --workspace @hyperkernel/playground --",
    "test:e2e": "npm run test:e2e --workspace @hyperkernel/playground --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.2",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "^3.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
